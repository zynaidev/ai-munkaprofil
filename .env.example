# Buildkor beégetődik a buildbe: ebből készül a kanonikus URL, az OG-kép, a sitemap és a robots.txt.
# Coolifyban build-változóként kell beállítani; ha megváltozik, újra kell buildelni.
NEXT_PUBLIC_SITE_URL=https://ai-munkaprofil.zynai.hu

# Futásidejű, csak szerveroldali: az n8n webhook, amely a visszajelzéseket fogadja (/api/visszajelzes).
# Coolifyban futásidejű változóként kell beállítani. Soha ne kapjon NEXT_PUBLIC_ előtagot.
# Ha hiányzik, a végpont nem továbbít, hanem a szerver konzoljára naplózza a payloadot, ezért élesben kötelező.
VISSZAJELZES_WEBHOOK_URL=
